{
  "name": "cool-admin",
  "version": "8.0.0",
  "description": "一个很酷的Ai快速开发框架",
  "private": true,
  "dependencies": {
    "@cool-midway/core": "8.0.7",
    "@cool-midway/rpc": "8.0.1",
    "@cool-midway/task": "8.0.2",
    "@langchain/classic": "^1.0.1",
    "@langchain/cohere": "^1.0.0",
    "@langchain/community": "^1.0.0",
    "@langchain/core": "^1.0.1",
    "@langchain/deepseek": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/mcp-adapters": "^1.0.0",
    "@langchain/ollama": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "@langchain/textsplitters": "^1.0.0",
    "@midwayjs/bootstrap": "^3.20.11",
    "@midwayjs/cache-manager": "^3.20.11",
    "@midwayjs/core": "^3.20.11",
    "@midwayjs/cron": "^3.20.11",
    "@midwayjs/cross-domain": "^3.20.16",
    "@midwayjs/info": "^3.20.16",
    "@midwayjs/koa": "^3.20.16",
    "@midwayjs/logger": "^4.0.1",
    "@midwayjs/socketio": "^3.20.11",
    "@midwayjs/static-file": "^3.20.16",
    "@midwayjs/typeorm": "^3.20.11",
    "@midwayjs/upload": "^3.20.16",
    "@midwayjs/validate": "^3.20.16",
    "@modelcontextprotocol/sdk": "^1.20.1",
    "adm-zip": "^0.5.16",
    "axios": "^1.12.2",
    "chromadb": "^3.0.17",
    "crawlee": "^3.15.1",
    "cron": "^4.3.3",
    "d3-dsv": "^3.0.1",
    "download": "^8.0.0",
    "js-tiktoken": "^1.0.21",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.0.1",
    "lodash": "^4.17.21",
    "mammoth": "^1.11.0",
    "md5": "^2.3.0",
    "moment": "^2.30.1",
    "officeparser": "^4.0.4",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "svg-captcha": "^1.4.0",
    "tslib": "^2.8.1",
    "turndown": "^7.2.1",
    "typeorm": "npm:@cool-midway/typeorm@0.3.20",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@midwayjs/bundle-helper": "^1.3.0",
    "@midwayjs/mock": "^3.20.11",
    "@types/jest": "^30.0.0",
    "@types/node": "24",
    "@yao-pkg/pkg": "^6.9.0",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "mwts": "^1.3.0",
    "mwtsc": "^1.15.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.5",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "NODE_ENV=production node ./bootstrap.js",
    "dev": "rimraf src/index.ts && cool check && cross-env NODE_ENV=local mwtsc --cleanOutDir --watch --run @midwayjs/mock/app.js --keepalive",
    "test": "cross-env NODE_ENV=unittest jest",
    "cov": "jest --coverage",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "npm run cov",
    "build": "cool entity && bundle && mwtsc --cleanOutDir",
    "build:obfuscate": "cool entity && bundle && mwtsc --cleanOutDir && cool obfuscate",
    "pkg": "rimraf build && mkdir build && npm run build && pkg . -d > build/pkg.log",
    "pm2:start": "pm2 start ./bootstrap.js -i 1 --name cool-admin",
    "pm2:stop": "pm2 stop cool-admin & pm2 delete cool-admin"
  },
  "bin": "./bootstrap.js",
  "pkg": {
    "scripts": [
      "dist/**/*",
      "node_modules/axios/dist/node/*"
    ],
    "assets": [
      "public/**/*",
      "typings/**/*",
      "src/locales/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "build"
  },
  "repository": {
    "type": "git",
    "url": "https://cool-js.com"
  },
  "author": "COOL",
  "license": "MIT"
}
